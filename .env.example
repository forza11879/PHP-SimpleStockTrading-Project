# Session secret — set a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional SMTP settings (if unset, password-reset emails are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Noreply <noreply@example.com>"

# Public URL used in password-reset links
HOST=http://localhost:3000

# Optional: custom SQLite database file location
# DB_PATH=/absolute/path/to/trading.db