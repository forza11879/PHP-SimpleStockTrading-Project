# Session secret — set a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional SMTP settings (if unset, password-reset emails are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Noreply <noreply@example.com>"

# Public URL used in password-reset links
HOST=http://localhost:3000

# Google social login (OAuth 2.0 / OpenID Connect).
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application") and add
#   <HOST>/api/auth/google/callback
# as an authorized redirect URI. Never commit real values — production
# secrets live in the hosting environment, not in this file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override the OAuth redirect URI (defaults to
# <HOST>/api/auth/google/callback). Must match an authorized redirect URI
# in the Google Cloud console exactly.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional: custom SQLite database file location
# DB_PATH=/absolute/path/to/trading.db